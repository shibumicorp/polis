#!/usr/bin/env groovy

pipeline {
    agent { label 'generic-nix-worker-single-exec' }

    options {
        timeout(time: 1, unit: 'HOURS')
        buildDiscarder(
            logRotator(
                artifactDaysToKeepStr: '',
                artifactNumToKeepStr: '',
                daysToKeepStr: '',
                numToKeepStr: '20'
            )
        )
    }

    environment {
        DOCKER_CRED = "07297589-e383-4f9e-bb0b-1df0165fb0c1"
        DOCKERFILE = "Dockerfile"
        GIT_CRED = "709e4237-6af4-4dec-bd6c-f449ceede3a2"
        GIT_URL = "https://github.com/shibumicorp/polis.git"
        IMAGE_BASE = "${env.ORG_NAME}/${env.SERVICE_NAME}"
        ORG_NAME = "222068622593.dkr.ecr.us-east-1.amazonaws.com"
        SERVICE_NAME = "polis"
        SLACK_CHANNEL = "#jenkins-build-alerts"
        SLACK_DOMAIN = "shibumi"
        SLACK_TOKEN = "ca1717b1-c157-4fe8-866e-8027d04d4cda"
        TARGET_LOCATION = "./"
    }

    stages {
        stage('Checkout git repo') {
            steps {
                script { checkoutRepo(env.GIT_URL, env.GIT_CRED, [params.BRANCH], 'develop') }
            }
        }

        stage('Run Build Steps') {
            steps {
                script { buildNixArtifact(output: 'bin') }
            }
        }

        stage('Build Docker images') {
            parallel {
                stage('Build x64 Docker image') {
                    steps {
                        script {
                            IMAGE_TAG = buildAndPushArchImage('x64', [
                                    pushMethod   : 'manual-docker',
                                    imageBase    : env.IMAGE_BASE,
                                    orgName      : env.ORG_NAME,
                                    versionMethod: 'json'
                            ])
                        }
                    }
                }

                stage('Build arm Docker image') {
                    agent { label 'generic-nix-arm-worker-single-exec' }
                    steps {
                        script {
                            checkoutRepo(env.GIT_URL, env.GIT_CRED, [params.BRANCH], 'develop')
                            IMAGE_TAG = buildAndPushArchImage('arm', [
                                    pushMethod   : 'manual-docker',
                                    imageBase    : env.IMAGE_BASE,
                                    orgName      : env.ORG_NAME,
                                    versionMethod: 'json'
                            ])
                        }
                    }
                }
            }
        }

        stage('Build combined Docker image') {
            steps {
                script {
                    publishManifests([env.IMAGE_BASE], IMAGE_TAG, env.ORG_NAME)
                }
            }
        }

        stage('Save tag name in file') {
            agent {
                docker {
                    image '222068622593.dkr.ecr.us-east-1.amazonaws.com/jenkins-node-images:gen0.1'
                    reuseNode true
                    registryUrl 'https://222068622593.dkr.ecr.us-east-1.amazonaws.com'
                    registryCredentialsId 'ecr:us-east-1:GENERIC_ECR'
                    args '-u root:root --network host -v /var/run/docker.sock:/var/run/docker.sock'
                }
            }
            steps {
                script { archiveImageTagFile(env.SERVICE_NAME, IMAGE_TAG) }
            }
        }

        stage("Deploy to environment") {
            agent {
                docker {
                    image '222068622593.dkr.ecr.us-east-1.amazonaws.com/jenkins-node-images:gen0.1'
                    reuseNode true
                    registryUrl 'https://222068622593.dkr.ecr.us-east-1.amazonaws.com'
                    registryCredentialsId 'ecr:us-east-1:GENERIC_ECR'
                    args '-u root:root --network host -v /var/run/docker.sock:/var/run/docker.sock'
                }
            }
            when {
                expression { env.JOB_BASE_NAME.contains('custom') }
            }
            steps {
                script { deployToEnv(env.SERVICE_NAME, params.DEPLOY_ENV, IMAGE_TAG) }
            }
        }
    }

    post {
        always {
            cleanWs()
            script {
                notifyBuildFailureSlack(env.SLACK_CHANNEL, env.SLACK_TOKEN, env.SLACK_DOMAIN)
            }
        }
    }
}
